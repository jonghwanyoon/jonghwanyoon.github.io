---
import Icon from './Icon.astro';
import { categories, getPosts } from '../lib/posts';
const posts = await getPosts();
const icons = { tech: 'code', papers: 'book', notes: 'pen' };
---
<aside class="sidebar" aria-label="글 분류">
  <section class="sidebar-section">
    <h2>분류</h2>
    <div class="topic-links">
      {Object.entries(categories).map(([key, category]) => (
        <a href={`/category/${key}/`}>
          <span class={`topic-icon ${key}`}><Icon name={icons[key as keyof typeof icons]}/></span>
          <span>{category.label}</span>
          <span class="topic-count">{posts.filter(p => p.data.category === key).length}</span>
          <Icon name="right" size={15}/>
        </a>
      ))}
    </div>
  </section>
</aside>
