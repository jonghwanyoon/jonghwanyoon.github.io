---
import Icon from './Icon.astro';
import { SITE_TITLE } from '../consts';
const [brandName, ...brandSuffix] = SITE_TITLE.split('.');
const pathname = Astro.url.pathname;
---
<header class="site-header">
  <div class="header-inner shell">
    <a href="/" class="brand" aria-label={`${SITE_TITLE} 홈`}><span class="brand-symbol">j<span>.</span></span><span>{brandName}<span class="brand-suffix">{brandSuffix.length ? `.${brandSuffix.join('.')}` : ''}</span></span></a>
    <nav class="main-nav" aria-label="메인 메뉴">
      <a href="/blog/" aria-current={pathname.startsWith('/blog') ? 'page' : undefined}>글</a>
      <a href="/category/papers/" aria-current={pathname.startsWith('/category/papers') ? 'page' : undefined}>논문 노트</a>
      <a href="/about/" aria-current={pathname === '/about/' ? 'page' : undefined}>소개</a>
    </nav>
    <div class="header-tools">
      <button class="search-trigger" data-open-search aria-label="블로그 검색 열기"><Icon name="search" size={18}/><span>검색</span><kbd>⌘ K</kbd></button>
      <button class="icon-button theme-toggle" id="theme-toggle" aria-label="다크 모드로 전환"><Icon name="moon" class="moon-icon"/><Icon name="sun" class="sun-icon"/></button>
    </div>
  </div>
</header>
