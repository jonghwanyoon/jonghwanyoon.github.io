---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import Icon from '../components/Icon.astro';
import { getPosts } from '../lib/posts';
import { SITE_DESCRIPTION } from '../consts';
const posts = await getPosts();
---
<BaseLayout>
  <div class="home-content shell">
    <section class="latest-section" aria-labelledby="latest-title">
      <p class="home-description">{SITE_DESCRIPTION}</p>
      <div class="section-heading">
        <h1 id="latest-title">최근 글</h1>
        <a class="text-link" href="/blog/">전체 글 <Icon name="right" size={17}/></a>
      </div>
      {posts.length ? (
        <div class="post-list">{posts.slice(0, 5).map(post => <PostCard post={post}/>)}</div>
      ) : (
        <div class="empty-state"><p>아직 작성한 글이 없습니다.</p></div>
      )}
    </section>
    <Sidebar/>
  </div>
</BaseLayout>
