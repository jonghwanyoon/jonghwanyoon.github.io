---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Archive from '../../components/Archive.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getPosts } from '../../lib/posts';
const posts = await getPosts();
---
<BaseLayout title="전체 기록" description="기술, 논문, 학습 기록의 전체 글 목록.">
  <div class="shell"><header class="page-heading"><h1>전체 글</h1></header><div class="archive-layout"><section aria-label="글 목록"><Archive posts={posts}/></section><Sidebar/></div></div>
</BaseLayout>
